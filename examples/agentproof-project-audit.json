{
  "name": "agentproof-self-audit",
  "allow_partial": false,
  "distributions": ["agentproof", "pytest", "ruff", "build"],
  "environment_names": ["CI", "GITHUB_ACTIONS", "GITHUB_REF_NAME", "GITHUB_SHA"],
  "checks": [
    {
      "name": "test-suite",
      "command": ["python", "-m", "pytest", "-ra", "-o", "addopts="],
      "claim": "All tests passed.",
      "timeout_seconds": 600,
      "expected_exit_code": 0
    },
    {
      "name": "ruff",
      "command": ["python", "-m", "ruff", "check", "src", "tests"],
      "timeout_seconds": 300,
      "expected_exit_code": 0
    },
    {
      "name": "package-build",
      "command": ["python", "-m", "build"],
      "timeout_seconds": 300,
      "expected_exit_code": 0
    }
  ],
  "artifacts": [
    {"path": "dist/agentproof-0.5.0-py3-none-any.whl"},
    {"path": "dist/agentproof-0.5.0.tar.gz"}
  ]
}
