{
  "name": "claimforge-v0.6-internal-case-study",
  "allow_partial": false,
  "distributions": ["claimforge", "pytest", "ruff"],
  "environment_names": ["CI", "GITHUB_ACTIONS", "GITHUB_REF_NAME", "GITHUB_SHA"],
  "checks": [
    {
      "name": "claimforge-tests",
      "command": ["python", "-m", "pytest", "-ra", "-o", "addopts="],
      "claim": "All tests passed.",
      "timeout_seconds": 1200,
      "expected_exit_code": 0
    },
    {
      "name": "claimforge-lint",
      "command": ["python", "-m", "ruff", "check", "."],
      "timeout_seconds": 300,
      "expected_exit_code": 0
    },
    {
      "name": "public-claim-validation",
      "command": ["python", "scripts/validate_public_claims.py"],
      "timeout_seconds": 300,
      "expected_exit_code": 0
    }
  ],
  "artifacts": [
    {"path": "README.md"},
    {"path": "docs/evidence/validation_suite_summary.json"}
  ]
}
